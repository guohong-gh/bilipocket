# 统一换行符：仓库内一律 LF，检出时由各平台自行决定
* text=auto eol=lf

# 明确二进制，避免被当成文本做换行转换或 diff
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.icns binary
*.exe  binary
*.dll  binary
*.zip  binary

# 锁文件不参与 diff 统计噪音
package-lock.json  -diff
src-tauri/Cargo.lock -diff

# 语言统计时排除演示与第三方文本
dev/assets/** linguist-vendored
LICENSES/** linguist-vendored
