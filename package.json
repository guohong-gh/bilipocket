{
  "name": "bilipocket",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "description": "本地优先的哔哩哔哩下载器桌面应用",
  "license": "MIT",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "package:portable": "node scripts/package-portable.mjs",
    "check": "node scripts/build.mjs --no-bundle",
    "verify:privacy": "node scripts/verify-privacy.mjs",
    "tauri": "tauri",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "set:update-source": "node scripts/set-update-source.mjs",
    "make:latest": "node scripts/update-manifest.mjs",
    "build:release": "node scripts/build-release.mjs",
    "test:ui": "playwright test",
    "test:desktop": "node scripts/e2e-desktop.mjs",
    "test:desktop:extras": "node scripts/e2e-extras.mjs",
    "test:desktop:recovery": "node scripts/e2e-recovery.mjs",
    "test:desktop:retry": "node scripts/e2e-desktop.mjs --auto-retry",
    "test:desktop:update": "node scripts/e2e-update-check.mjs",
    "test:desktop:auth": "node scripts/e2e-auth-qr.mjs",
    "test:desktop:priority": "node scripts/e2e-priority.mjs",
    "test:desktop:session-expiry": "node scripts/e2e-session-expiry.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2",
    "typescript": "^5.9.3"
  }
}
